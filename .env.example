# Copiar a .env y completar. chmod 600. NUNCA va a git.

# Clave de la base. La genera: openssl rand -base64 32
POSTGRES_PASSWORD=

# Catalogo de canciones: "local" o "spotify".
# Sin credenciales, dejar en local: el circuito funciona igual con el catalogo
# semilla de app/catalogo/semilla.json.
TINKER_CATALOGO=local

# Credenciales de Spotify (developer.spotify.com). Solo hacen falta con
# TINKER_CATALOGO=spotify. Es el flujo client_credentials: alcanza para BUSCAR.
# Crear la playlist al final del evento necesita ademas un token de usuario,
# que todavia no esta implementado.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Mercado para la busqueda de Spotify. PY = Paraguay.
SPOTIFY_MERCADO=PY

# Evento de demostracion al arrancar con la base vacia. En produccion, "no".
# Vale si / sí / yes / 1 / true. CUALQUIER otro valor cuenta como "no":
# poner "demo" aca no siembra nada y no avisa.
TINKER_SEMILLA=si

# Swagger UI en /docs. Apagado salvo que se pida. compose.dev.yaml lo
# enciende solo; en produccion se deja en "no".
TINKER_DOCS=no

# TINKER_BD NO se pone aca. Los dos compose la fijan en su bloque
# environment, que le gana al env_file, para que la URL no pueda
# desincronizarse del servicio de base que levantan. Si algun dia se corre
# la app fuera de Docker, el formato es:
#   postgresql+psycopg://tinker_usuario:CLAVE@localhost:5432/tinker
# El sufijo +psycopg no es opcional: psycopg3 es el driver instalado y sin
# el SQLAlchemy busca psycopg2, que no esta.

# ─── El motor que arma las tandas ───────────────────────────────────────
#
# Cada proveedor entra SOLO si tiene su clave, en este orden:
# gemini -> claude -> openai. Sin ninguna, el juego se juega igual: las tandas
# salen de las reglas deterministas y nadie ve un error.
#
# El orden lo decidio una medicion previa en este mismo servidor:
# gemini-3.5-flash-lite
# contesta en 3,2 s, claude-opus-5 en 6,2 y gpt-5-mini en 24. En un juego donde
# la espera entre tandas se nota, ese orden vale mas que en cualquier otro uso.
#
# ⚠ HOY SON LAS MISMAS CLAVES QUE USA FOCUS. Tiene un costo aceptado: rotarlas
# rompe los dos proyectos y el gasto se mezcla sin forma de separarlo. Para
# medir lo que cuesta un evento conviene darle a tinker sus propias claves.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Los identificadores de modelo, por si hay que cambiarlos sin tocar codigo.
TINKER_IA_GEMINI=gemini-3.5-flash-lite
TINKER_IA_CLAUDE=claude-opus-5
TINKER_IA_OPENAI=gpt-5-mini
