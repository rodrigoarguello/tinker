# Copy to .env and fill in. chmod 600. NEVER commit this.

# ── Database ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Only needed when running outside docker compose (compose builds this).
# TINKER_BD=postgresql+psycopg://tinker_usuario:PASSWORD@localhost:5432/tinker

# ── Catalog ─────────────────────────────────────────────────────────────
# "local" or "spotify". With no credentials, leave it local: the whole loop
# works from the seed catalog in app/catalogo/semilla.json.
TINKER_CATALOGO=local

# Spotify (developer.spotify.com). Only needed with TINKER_CATALOGO=spotify.
# client_credentials is enough to SEARCH. Writing to the playlist also needs
# a one-time user consent, done from /admin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MERCADO=PY

# Seed a playable demo event when the database is empty. "no" in production.
TINKER_SEMILLA=si

# ── The engine that builds the rounds ───────────────────────────────────
#
# Each provider joins ONLY if its key is present, in this order:
# gemini -> claude -> openai. With none of them the game plays exactly the
# same: rounds come out of the deterministic rules and nobody sees an error.
#
# The order was decided by measurement on this server, not by preference:
# 3.2 s vs 6.2 s vs 24 s on the equivalent task. In a game where the wait
# between rounds is felt, that ordering outranks everything else.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model ids, so they can be changed without touching code.
TINKER_IA_GEMINI=gemini-3.5-flash-lite
TINKER_IA_CLAUDE=claude-opus-5
TINKER_IA_OPENAI=gpt-5-mini
